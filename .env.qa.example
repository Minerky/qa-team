# Template input uji — SALIN ke .env.qa di workspace, lalu isi di file salinan.
# .env.qa sudah masuk .gitignore. Jangan commit nilai asli dan jangan ketik di chat.

TARGET_URL=https://staging.contoh.com
QA_USER=qa_user_uat
QA_PASS=ISI_DI_FILE_LOKAL

# Khusus aplikasi DCT / FLM (Test Mode)
QA_TEST_MODE_PIN=ISI_DI_FILE_LOKAL

# Opsional: serial ADB bila auto-resolve tidak menemukan device
# QA_ANDROID_SERIAL=emulator-5554
